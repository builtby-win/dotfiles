#!/usr/bin/env python3
# Invoke a plugin action after closing any open popup; Herdr rejects a second
# popup with "a popup pane is already open".
import json
import os
import socket
import sys

herdr = os.environ.get("HERDR_BIN_PATH", "herdr")
socket_path = os.environ.get("HERDR_SOCKET_PATH") or os.path.expanduser("~/.config/herdr/herdr.sock")
try:
    with socket.socket(socket.AF_UNIX, socket.SOCK_STREAM) as client:
        client.settimeout(2)
        client.connect(socket_path)
        client.sendall((json.dumps({"id": "herdr-plugin-action", "method": "popup.close", "params": {}}) + "\n").encode())
        client.makefile().readline()
except OSError:
    pass

os.execvp(herdr, [herdr, "plugin", "action", "invoke", *sys.argv[1:]])
