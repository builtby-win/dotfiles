#!/usr/bin/env python3
"""Confirm before closing a Rex pane whose agent is working or blocked.

  rex-confirm-close SESSION BLOCK

Opened by the pane_close_confirm action (Leader+W / Leader+X) only when the
pane is busy; idle panes close without asking. y closes, any other key keeps it.
"""
import json
import subprocess
import sys
import termios
import tty

session_id, block_id = sys.argv[1:3]


def call(method):
    result = subprocess.run(
        ["rex", "block", "call", "-s", session_id, "-b", block_id, method],
        capture_output=True, text=True,
    )
    try:
        return json.loads(result.stdout or "{}")
    except ValueError:
        return {}


records = call("program_status").get("records") or []
record = next((r for r in records if r.get("state") in ("working", "blocked")), records[0] if records else {})
app = record.get("effective_app") or record.get("app") or "program"
title = " ".join(str(call("title").get("title") or "").split())
if len(title) > 40:
    title = title[:39] + "…"

color = "\033[1;31m" if record.get("state") == "working" else "\033[36m"
sys.stdout.write("\033[?25l\033[2J\033[H\r\n")
sys.stdout.write("  \033[1;33m⚠  Close this pane?\033[0m\r\n")
sys.stdout.write(f"     {color}{app} ({record.get('state', 'busy')})\033[0m\r\n")
sys.stdout.write(f"     \033[2m{title}\033[0m\r\n\r\n" if title else "\r\n")
sys.stdout.write("  \033[1m[y]\033[0m close   \033[2m[any key] cancel\033[0m ")
sys.stdout.flush()

fd = sys.stdin.fileno()
saved = termios.tcgetattr(fd)
try:
    tty.setcbreak(fd)
    answer = sys.stdin.read(1)
except (KeyboardInterrupt, EOFError):
    answer = ""
finally:
    termios.tcsetattr(fd, termios.TCSADRAIN, saved)
    sys.stdout.write("\033[?25h")

if answer in ("y", "Y"):
    subprocess.run(["rex", "block", "close", "-s", session_id, block_id], check=False)
