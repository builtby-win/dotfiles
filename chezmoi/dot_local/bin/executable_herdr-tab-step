#!/usr/bin/env python3
"""Move to the adjacent tab, wrapping within the workspace.

While the focused tab is zoomed, step between its panes first (keeping the
zoom on the newly focused pane); at the first/last pane, move to the adjacent tab.

With "swipe" (mobile), the zoom is always applied: panes are stepped zoomed even
if the tab was not zoomed, and the adjacent tab is entered zoomed on its first
(next) or last (prev) pane.
"""
import json
import os
import socket
import sys

socket_path = os.environ.get("HERDR_SOCKET_PATH") or os.path.expanduser("~/.config/herdr/herdr.sock")


def call(method, params=None):
    request = {"id": "herdr-tab-step", "method": method, "params": params or {}}
    with socket.socket(socket.AF_UNIX, socket.SOCK_STREAM) as client:
        client.settimeout(2)
        client.connect(socket_path)
        client.sendall((json.dumps(request) + "\n").encode())
        response = json.loads(client.makefile().readline())
    if "error" in response:
        raise SystemExit(response["error"].get("message", "Herdr request failed"))
    return response["result"]

direction = sys.argv[1]
if direction not in ("prev", "next") or sys.argv[2:] not in ([], ["swipe"]):
    raise SystemExit("usage: herdr-tab-step prev|next [swipe]")
swipe = sys.argv[2:] == ["swipe"]

snapshot = call("session.snapshot")["snapshot"]
current_workspace_id = snapshot["focused_workspace_id"]
current_tab_id = snapshot["focused_tab_id"]
tabs = [tab for tab in snapshot["tabs"] if tab["workspace_id"] == current_workspace_id]
tab_index = next(i for i, item in enumerate(tabs) if item["tab_id"] == current_tab_id)
step = -1 if direction == "prev" else 1

layout = next((l for l in snapshot["layouts"] if l["tab_id"] == current_tab_id), None)
if layout and (swipe or layout.get("zoomed")):
    pane_ids = [pane["pane_id"] for pane in layout["panes"]]
    target_index = pane_ids.index(layout["focused_pane_id"]) + step
    if 0 <= target_index < len(pane_ids):
        call("pane.focus", {"pane_id": pane_ids[target_index]})
        call("pane.zoom", {"pane_id": pane_ids[target_index], "mode": "on"})
        raise SystemExit(0)

target_tab_id = tabs[(tab_index + step) % len(tabs)]["tab_id"]
call("tab.focus", {"tab_id": target_tab_id})

if swipe:
    # Enter the new tab zoomed on the pane nearest the edge we crossed.
    target = next((l for l in snapshot["layouts"] if l["tab_id"] == target_tab_id), None)
    if target and target["panes"]:
        pane_id = target["panes"][0 if step > 0 else -1]["pane_id"]
        call("pane.focus", {"pane_id": pane_id})
        call("pane.zoom", {"pane_id": pane_id, "mode": "on"})
