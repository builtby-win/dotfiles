#!/usr/bin/env python3
"""Move to the adjacent tab, crossing workspace boundaries when needed.

While the focused tab is zoomed, step between its panes instead (wrapping),
keeping the zoom on the newly focused pane.
"""
import json
import os
import socket
import sys

socket_path = os.environ.get("HERDR_SOCKET_PATH") or os.path.expanduser("~/.config/herdr/herdr.sock")


def call(method, params=None):
    request = {"id": "herdr-tab-step", "method": method, "params": params or {}}
    with socket.socket(socket.AF_UNIX, socket.SOCK_STREAM) as client:
        client.settimeout(2)
        client.connect(socket_path)
        client.sendall((json.dumps(request) + "\n").encode())
        response = json.loads(client.makefile().readline())
    if "error" in response:
        raise SystemExit(response["error"].get("message", "Herdr request failed"))
    return response["result"]

direction = sys.argv[1]
if direction not in ("prev", "next"):
    raise SystemExit("usage: herdr-tab-step prev|next")

snapshot = call("session.snapshot")["snapshot"]
workspaces = sorted(snapshot["workspaces"], key=lambda workspace: workspace["number"])
current_workspace_id = snapshot["focused_workspace_id"]
current_tab_id = snapshot["focused_tab_id"]
workspace_index = next(i for i, item in enumerate(workspaces) if item["workspace_id"] == current_workspace_id)
tabs = [tab for tab in snapshot["tabs"] if tab["workspace_id"] == current_workspace_id]
tab_index = next(i for i, item in enumerate(tabs) if item["tab_id"] == current_tab_id)
step = -1 if direction == "prev" else 1

layout = next((l for l in snapshot["layouts"] if l["tab_id"] == current_tab_id), None)
if layout and layout.get("zoomed") and len(layout["panes"]) > 1:
    pane_ids = [pane["pane_id"] for pane in layout["panes"]]
    pane_index = pane_ids.index(layout["focused_pane_id"])
    target_pane_id = pane_ids[(pane_index + step) % len(pane_ids)]
    call("pane.focus", {"pane_id": target_pane_id})
    call("pane.zoom", {"pane_id": target_pane_id, "mode": "on"})
    raise SystemExit(0)
next_tab_index = tab_index + step

if 0 <= next_tab_index < len(tabs):
    target_tab = tabs[next_tab_index]
else:
    next_workspace_index = workspace_index + step
    if not 0 <= next_workspace_index < len(workspaces):
        raise SystemExit(0)
    target_workspace_id = workspaces[next_workspace_index]["workspace_id"]
    target_tabs = [tab for tab in snapshot["tabs"] if tab["workspace_id"] == target_workspace_id]
    target_tab = target_tabs[0] if direction == "next" else target_tabs[-1]

call("tab.focus", {"tab_id": target_tab["tab_id"]})
