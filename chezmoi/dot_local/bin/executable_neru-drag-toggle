#!/bin/bash
# Toggle mouse drag state for NERU grid modes.
# First call: mouse_down (start drag), creates state file.
# Second call: mouse_up (end drag), removes state file.
# On unexpected exit paths, cleanup_neru_drag.sh removes the state file.

ST="/tmp/neru-drag"
if [ -f "$ST" ]; then
  rm "$ST"
  neru action mouse_up
else
  touch "$ST"
  neru action mouse_down
fi
