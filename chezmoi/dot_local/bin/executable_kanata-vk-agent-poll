#!/usr/bin/env bash
set -euo pipefail

SOURCE="${HOME}/.local/lib/kanata-vk-agent-poll.swift"
CACHE_DIR="${HOME}/.cache/kanata-vk-agent-poll"
BINARY="${CACHE_DIR}/kanata-vk-agent-poll"
LOCK_DIR="${CACHE_DIR}/.build.lock"

if [[ ! -f "$SOURCE" ]]; then
  echo "kanata-vk-agent-poll: missing source: $SOURCE" >&2
  exit 1
fi

mkdir -p "$CACHE_DIR"
if [[ ! -x "$BINARY" || "$SOURCE" -nt "$BINARY" ]]; then
  if mkdir "$LOCK_DIR" 2>/dev/null; then
    trap 'rm -rf "$LOCK_DIR" "$BINARY.tmp.$$"' EXIT
    if [[ ! -x "$BINARY" || "$SOURCE" -nt "$BINARY" ]]; then
      /usr/bin/swiftc "$SOURCE" -o "$BINARY.tmp.$$"
      mv "$BINARY.tmp.$$" "$BINARY"
    fi
    rm -rf "$LOCK_DIR"
    trap - EXIT
  else
    for _ in {1..100}; do
      [[ -x "$BINARY" && ! "$SOURCE" -nt "$BINARY" ]] && break
      sleep 0.1
    done
  fi
fi

exec "$BINARY" "$@"
