# Font
font-family = "JetBrainsMono Nerd Font"
font-size = 14

# Theme
theme = Catppuccin Frappe
background-opacity = 0.95
background-blur-radius = 20

# Window
window-padding-x = 12
window-padding-y = 12
window-decoration = true
# Not `hidden`: that mode has no tab bar, so every new tab opens as a window.
macos-titlebar-style = transparent

# Cursor
cursor-style = block
cursor-style-blink = false

# Shell integration
shell-integration = zsh
shell-integration-features = sudo,ssh-terminfo,ssh-env

# Keybindings
# Forward Shift+Enter as CSI-u so pi/tmux can distinguish it from plain Enter.
keybind = shift+enter=text:\x1b[13;2u
keybind = cmd+t=new_tab
keybind = cmd+w=close_surface
keybind = cmd+shift+]=next_tab
keybind = cmd+shift+[=previous_tab
keybind = ctrl+tab=next_tab
keybind = ctrl+shift+tab=previous_tab
keybind = cmd+1=unbind
keybind = cmd+2=unbind
keybind = cmd+3=unbind
keybind = cmd+4=unbind
keybind = cmd+5=unbind
keybind = cmd+6=unbind
keybind = cmd+7=unbind
keybind = cmd+8=unbind
keybind = cmd+9=unbind
keybind = cmd+shift+p=unbind
keybind = cmd+shift+m=unbind
keybind = cmd+shift+a=unbind
keybind = cmd+shift+o=unbind
keybind = cmd+d=new_split:right
keybind = cmd+shift+d=new_split:down
keybind = cmd+enter=unbind

# Clipboard
clipboard-read = allow
clipboard-write = allow

# Performance
copy-on-select = clipboard
confirm-close-surface = false

# macOS specific
macos-option-as-alt = true
macos-auto-secure-input = true
macos-non-native-fullscreen = false

# Scrollback
scrollback-limit = 10000000

# URL handling
link-url = true

# Working directory
window-inherit-working-directory = true
