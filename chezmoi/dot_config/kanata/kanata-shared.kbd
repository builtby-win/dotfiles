;; Shared between kanata.kbd (non-Sculpt) and kanata-sculpt.kbd.
;; Both main configs (include kanata-shared.kbd) at the bottom of the file.
;; Do not run this standalone — it has no defcfg.
;;
;; What lives here:
;; - `defalias` for behavior aliases that do not depend on the keyboard's
;;   physical modifier shape (chords, layers, app-aware switches, mouse, etc).
;; - `defvirtualkeys` for the kanata-vk-agent app-focus virtual keys.
;; - `defsrc` (identical between profiles).
;; - Layers whose contents are identical between profiles: `hyperlayer`, `fn`,
;;   `nav`, `mouse`, `jheld`.
;;
;; What stays per-profile (in kanata.kbd / kanata-sculpt.kbd):
;; - `defcfg` (each profile filters a different set of devices).
;; - The `os-*` one-shot modifier aliases (Sculpt's `os-rsft` differs).
;; - `deflayer base`, `cmd`, `neruscroll`, `nerumode` — they differ either in
;;   the left-modifier physical order or in ralt's behavior.
;; - `defchordsv2` — Sculpt's esc+spc timeout differs.
;;
;; App-aware behavior here (terminal leader, Vivaldi nav, GUI editor j hold)
;; relies on kanata-vk-agent pressing the matching virtual keys when those
;; apps gain focus. Keep these terminal/editor/Vivaldi bundle IDs mirrored
;; with `defvirtualkeys` below and scripts/setup-kanata-macos.sh.

(defalias
  ;; Tap Right Option or Menu/Application for next-key Hyper; hold for held Hyper.
  ;; Meta is Cmd on macOS.
  hyper (multi lctl lalt lsft lmet reverse-release-order)
  ;; One-shot the actual Hyper chord; one-shot layers can be consumed by tap-hold
  ;; release events before the intended next key.
  hyper-next (one-shot-press-pcancel 2000 C-A-S-lmet)
  hyper-key (tap-hold 200 200 @hyper-next @hyper)
  ;; Tap Caps for Escape, hold for Control.
  cap (tap-hold 200 200 esc lctl)
  ;; Hold Fn for raw function keys; tap/hold otherwise acts as Control.
  fn (tap-hold 200 200 lctl (layer-while-held fn))
  ;; Double-tap semicolon for AltTab's Ctrl+Option+Tab shortcut.
  semi (tap-dance 200 (; (macro C-A-tab)))
  ;; Keep j clean while preserving the deliberate held-j + Space Backspace path.
  ;; tap-hold-tap-keys emits j early on normal rolls instead of waiting for
  ;; release, so fast typing does not feel laggy or reorder j behind later keys.
  j-home (tap-hold-tap-keys 200 200 j (multi j (layer-while-held jheld)) (a b c d e f g h i k l m n o p q r s t u v w x y z 4 tab grv ; spc))
  ;; In GUI editors with Vim mode, j is plain for cleanest repeat.
  editor-j (switch
    ((input virtual dev.zed.Zed)) j break
    ((input virtual com.microsoft.VSCode)) j break
    ((input virtual com.todesktop.230313mzl4w4u92)) j break
    () @j-home break
  )
  bksp-repeat (macro-repeat-release-cancel bspc 85)
  nav-layer (layer-while-held nav)
  mouse-layer (layer-while-held mouse)
  mm-up (movemouse-accel-up 1 1000 1 5)
  mm-down (movemouse-accel-down 1 1000 1 5)
  mm-left (movemouse-accel-left 1 1000 1 5)
  mm-right (movemouse-accel-right 1 1000 1 5)
  mw-up (mwheel-up 50 120)
  mw-down (mwheel-down 50 120)
  mw-left (mwheel-left 50 120)
  mw-right (mwheel-right 50 120)
  ;; Shared tmux/psmux leader action used by app-aware chords.
  leader (macro C-b)
  ;; App-aware aliases keep their switch logic here and expose semantic names
  ;; to chord definitions in each profile.
  ;; Outside terminals, j+k arms the Cmd layer for the next keypress only.
  ;; The timeout is just a safety cap if no next key arrives.
  cmd-next (one-shot 2000 (layer-while-held cmd))
  terminal-leader-or-cmd-layer (switch
    ((input virtual com.mitchellh.ghostty)) @leader break
    ((input virtual com.googlecode.iterm2)) @leader break
    ((input virtual com.apple.Terminal)) @leader break
    ((input virtual dev.warp.Warp-Stable)) @leader break
    ((input virtual net.kovidgoyal.kitty)) @leader break
    ((input virtual org.alacritty)) @leader break
    ((input virtual io.alacritty)) @leader break
    ((input virtual com.github.wez.wezterm)) @leader break
    ((input virtual com.cmuxterm.app)) @leader break
    () @cmd-next break
  )
  jk @terminal-leader-or-cmd-layer
  ;; Physical/Caps Ctrl + h/j/k/l/n/p becomes arrows; plain keys stay normal.
  ;; `input real` keeps virtual Hyper/Cmd-layer chords from tripping these.
  ctrl-h-or-left (switch
    ((input real lctl)) left break
    ((input real rctl)) left break
    ((input real caps)) left break
    () h break
  )
  ctrl-j-or-down (switch
    ((input real lctl)) down break
    ((input real rctl)) down break
    ((input real caps)) down break
    () @editor-j break
  )
  ctrl-k-or-up (switch
    ((input real lctl)) up break
    ((input real rctl)) up break
    ((input real caps)) up break
    () k break
  )
  ctrl-l-or-right (switch
    ((input real lctl)) rght break
    ((input real rctl)) rght break
    ((input real caps)) rght break
    () l break
  )
  ctrl-n-or-down (switch
    ((input real lctl)) down break
    ((input real rctl)) down break
    ((input real caps)) down break
    () n break
  )
  ctrl-p-or-up (switch
    ((input real lctl)) up break
    ((input real rctl)) up break
    ((input real caps)) up break
    () p break
  )
  neru (multi (macro C-A-S-M-k) (layer-switch nerumode))
  nudge (multi (macro C-A-S-M-;) (layer-switch nerumode))
  scroll (multi (macro C-A-S-M-s) (layer-switch nerumode))
  hints (multi (macro C-A-S-M-i) (layer-switch nerumode))
)

(defvirtualkeys
  com.mitchellh.ghostty nop0
  com.googlecode.iterm2 nop0
  com.apple.Terminal nop0
  dev.warp.Warp-Stable nop0
  net.kovidgoyal.kitty nop0
  org.alacritty nop0
  io.alacritty nop0
  com.github.wez.wezterm nop0
  com.cmuxterm.app nop0
  dev.zed.Zed nop0
  com.microsoft.VSCode nop0
  com.todesktop.230313mzl4w4u92 nop0
  com.vivaldi.Vivaldi nop0
)

;; Microsoft Sculpt's Application/Menu key arrives on this Mac as macOS
;; keyCode 110, which Kanata names `ins`, while other keyboards use `menu`.
;; Keep both source keys Hyper-mapped in each profile.
(defsrc
  lctl lsft lalt lmet ralt rmet rctl rsft menu ins caps fn del ; tab grv esc spc h j k l u d a e w b f c v x z q m r t y i o p s g n 4 f1 f2 f3 f4 f5 f6 f7 f8 f9 f10 f11 f12
)

(deflayer hyperlayer
  _ _ _ _ _ _ _ _ _ _ _ _ _ _ C-A-S-M-tab C-A-S-M-grv C-A-S-M-esc C-A-S-M-spc C-A-S-M-h C-A-S-M-j C-A-S-M-k C-A-S-M-l C-A-S-M-u C-A-S-M-d C-A-S-M-a C-A-S-M-e C-A-S-M-w C-A-S-M-b C-A-S-M-f C-A-S-M-c C-A-S-M-v C-A-S-M-x C-A-S-M-z C-A-S-M-q C-A-S-M-m C-A-S-M-r C-A-S-M-t C-A-S-M-y C-A-S-M-i C-A-S-M-o C-A-S-M-p C-A-S-M-s C-A-S-M-g C-A-S-M-n C-A-S-M-4 C-A-S-M-f1 C-A-S-M-f2 C-A-S-M-f3 C-A-S-M-f4 C-A-S-M-f5 C-A-S-M-f6 C-A-S-M-f7 C-A-S-M-f8 C-A-S-M-f9 C-A-S-M-f10 C-A-S-M-f11 C-A-S-M-f12
)

(deflayer fn
  _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ f1 f2 f3 f4 f5 f6 f7 f8 f9 f10 f11 f12
)

(deflayermap (nav)
  h left
  j down
  k up
  l rght
  u pgup
  d pgdn
  a M-left
  e M-rght
  w A-rght
  b A-left
  esc esc
  spc XX
)

(deflayermap (mouse)
  h @mm-left
  j @mm-down
  k @mm-up
  l @mm-right
  u @mw-up
  d @mw-down
  a @mw-left
  e @mw-right
  spc mlft
  ; mrgt
  m mmid
  esc esc
)

(deflayermap (jheld)
  spc @bksp-repeat
)

;; Neru nudge: entered via `n` from recursive_grid (NERU config.toml).
;; Maps h/j/k/l → arrow keys so NERU's existing 5px nudge bindings work.
;; Press `n` again to return to the normal recursive-grid Kanata layer without
;; leaving NERU. Escape and Space both switch back to base (defense-in-depth for
;; Kanata layer unwinding; NERU also runs `kanata-layer base` on its side).
(defalias
  esc-base (multi esc (layer-switch base))
  spc-base (multi spc (layer-switch base))
  nudge-off (layer-switch nerumode)
)
(deflayer nerunudge
  _ _ _ _ _ _ _ _ _ _ _ _ @esc-base _ _ _ @esc-base @spc-base left down up rght _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ @nudge-off _ _ _ _ _ _ _ _ _ _ _ _
)
