;; BuiltBy Microsoft Sculpt keyboard parity layer for Kanata.
;; Goals:
;; - This profile handles only the Microsoft Sculpt receiver.
;; - Menu/Application acts as Hyper (Ctrl+Alt+Shift+Meta/Win/Cmd).
;; - Left Option and Left Command are swapped to match Apple muscle memory.
;; - Right Option sends Right Command.
;; - Caps Lock is Escape when tapped and Control when held
;; - Delete Forward acts as Escape
;; - Letter-letter chords are disabled on the base layer so fast typing stays literal.
;; - NERU and launcher shortcuts stay reachable through explicit Hyper shortcuts.
;; - F1-F12 behave like the macOS media row by default; hold Fn for raw F keys.
;;
;; Run:
;;   kanata --cfg ~/.config/kanata/kanata-sculpt.kbd --port 5830
;;
;; Notes:
;; - Karabiner's `application` key is Kanata's `menu` key.
;; - App-specific behavior needs kanata-vk-agent plus Kanata's TCP server.
;; - Plain Kanata can filter devices, but it cannot do Karabiner-style per-device
;;   `device_if` mappings inside one active macOS config. This filtered profile is
;;   why Sculpt can have different modifiers without changing other keyboards.
;; - Behavior shared with kanata.kbd lives in kanata-shared.kbd, included at the
;;   bottom of this file. Keep `deflayer base` first so it remains the starting
;;   layer.

(defcfg
  macos-dev-names-include (
    "0xCB1EB82FC081667C"
  )
  process-unmapped-keys yes
  concurrent-tap-hold yes
  chords-v2-min-idle 100
  override-release-on-activation yes
)

;; One-shot modifier aliases. Kept per-profile because Sculpt deliberately
;; remaps `os-rsft` to lsft (the receiver reports right-shift differently from
;; other keyboards).
(defalias
  os-ctl (one-shot-press-pcancel 1000 lctl)
  os-sft (one-shot-press-pcancel 1000 lsft)
  os-alt (one-shot-press-pcancel 1000 lalt)
  os-cmd (one-shot-press-pcancel 1000 lmet)
  os-rctl (one-shot-press-pcancel 1000 rctl)
  os-rsft (one-shot-press-pcancel 1000 lsft)
  os-ralt (one-shot-press-pcancel 1000 ralt)
  os-rcmd (one-shot-press-pcancel 1000 rmet)
)

(deflayer base
  @os-ctl @os-sft @os-cmd @os-alt @os-rcmd @os-rcmd @os-rctl @os-rsft @hyper-key @cap @fn esc @semi tab grv esc spc h @editor-j k l u d a e w b f c v x z q m r t y i o p s g n 4 brdn brup mctl lpad bldn blup prev pp next mute voldwn volu
)

(deflayer cmd
  _ _ _ _ _ _ _ _ _ _ _ _ _ M-tab M-grv _ M-spc M-h M-j M-k M-l M-u M-d M-a M-e M-w M-b M-f M-c M-v M-x M-z M-q M-m M-r M-t M-y M-i M-o M-p M-s M-g M-n _ _ _ _ _ _ _ _ _ _ _ _ _
)

;; Neru scroll mode needs raw, repeatable motion keys. Keep j out of its
;; tap-hold behavior while Neru owns modal scrolling.
(deflayer neruscroll
  @os-ctl @os-sft @os-cmd @os-alt @os-rcmd @os-rcmd @os-rctl @os-rsft @hyper-key @cap @fn esc @semi tab grv esc spc h j k l u d a e w b f c v x z q m r t y i o p s g n 4 brdn brup mctl lpad bldn blup prev pp next mute voldwn volu
)

(deflayer nerumode
  @os-ctl @os-sft @os-cmd @os-alt @os-rcmd @os-rcmd @os-rctl @os-rsft @hyper-key @cap @fn (multi esc (layer-switch base)) @semi tab grv (multi esc (layer-switch base)) (multi spc (layer-switch base)) h j k l u d a e w b f c v x z q m r t y i o p s g n 4 brdn brup mctl lpad bldn blup prev pp next mute voldwn volu
)

;; fj, dk, and sl are intentionally reserved for future layers and remain unmapped in this pass.
(defchordsv2
  ;; (lctl p), (lctl n), (rctl p), (rctl n) intentionally omitted.
  ;; They conflicted with Hyper + p/n — see kanata.kbd for rationale.
  ;; Base typing wins: no letter-letter chords here. Fast rolls like jk, jl,
  ;; dk, df, and fj should always produce text, not commands or modal layers.
  ;; Use explicit Hyper shortcuts from Neru/Raycast/Hammerspoon for actions.
  (esc spc) XX 80 first-release (nerumode)
)

(include kanata-shared.kbd)
