# Config syntax crash course
# ==========================
# # The config file consists of simple key-value pairs,
# # separated by equals signs.
# font-family = Iosevka
# window-padding-x = 2
#
# # Spacing around the equals sign does not matter.
# # All of these are identical:
# key=value
# key= value
# key =value
# key = value
#
# # Any line beginning with a # is a comment. It's not possible to put
# # a comment after a config option, since it would be interpreted as a
# # part of the value. For example, this will have a value of "#123abc":
# background = #123abc
#
# # Empty values are used to reset config keys to default.
# key =
#
# # Some config options have unique syntaxes for their value,
# # which is explained in the docs for that config option.
# # Just for example:
# resize-overlay-duration = 4s 200ms

# Font (run `ghostty +list-fonts` to see available fonts)
font-family = JetBrains Mono
font-size = 18

# Window appearance
background-opacity = 0.95
background-blur = true
window-padding-x = 8
window-padding-y = 8

# Theme (supports light:X,dark:Y for auto-switching)
theme = Catppuccin Frappe

# Terminal type — use xterm-256color so tmux and remote hosts recognize it
term = xterm-256color

# Behavior
copy-on-select = true
shell-integration = detect
shell-integration-features = sudo,ssh-terminfo,ssh-env

# Quick terminal position (if using toggle_quick_terminal)
quick-terminal-position = top
quick-terminal-screen = main

# Forward Shift+Enter as CSI-u so pi/tmux can distinguish it from plain Enter.
keybind = shift+enter=text:\x1b[13;2u

# Tab navigation
keybind = ctrl+tab=next_tab
keybind = ctrl+shift+tab=previous_tab
keybind = cmd+1=csi:49;9u
keybind = cmd+2=csi:50;9u
keybind = cmd+3=csi:51;9u
keybind = cmd+4=csi:52;9u
keybind = cmd+5=csi:53;9u
keybind = cmd+6=csi:54;9u
keybind = cmd+7=csi:55;9u
keybind = cmd+8=csi:56;9u
keybind = cmd+9=csi:57;9u
keybind = cmd+shift+m=unbind
keybind = cmd+enter=unbind

# Cmd-key layer for Neovim (F13–F24 bridge).
# macOS Command never reaches terminal apps on its own, so each combo is
# forwarded as the byte sequence of a high function key. Those need no
# Kitty-protocol negotiation, so they survive herdr/tmux/ssh. The nvim side
# maps F13–F24 back to actions (keymaps.lua, "Cmd-key layer").
# NOTE: cmd+f overrides Ghostty's fullscreen toggle (still in the menu).
keybind = cmd+shift+p=text:\x1b[1;2P
keybind = cmd+shift+o=text:\x1b[1;2Q
keybind = cmd+p=text:\x1b[1;2Q
keybind = cmd+o=text:\x1b[1;2R
keybind = cmd+s=text:\x1b[1;2S
keybind = cmd+z=text:\x1b[15;2~
keybind = cmd+shift+z=text:\x1b[17;2~
keybind = cmd+a=text:\x1b[18;2~
keybind = cmd+shift+f=text:\x1b[19;2~
keybind = cmd+f=text:\x1b[20;2~
keybind = cmd+b=text:\x1b[21;2~
keybind = cmd+period=text:\x1b[23;2~
keybind = cmd+shift+d=text:\x1b[24;2~
keybind = cmd+slash=text:\x1f

# Performance optimizations
# Smooth out rendering for high-throughput tools (Claude Code/Gemini)

# Ensures the GPU picks the most efficient rendering path
macos-icon-ghost-color = #ffffff
