#!/usr/bin/env python3
"""Balance the tab affected by a pane event.

Event hooks only carry the tab for pane.created; pane.closed gives just the dead
pane id, so every run snapshots pane->tab in the plugin state dir and closes
resolve the tab from the previous snapshot.
"""
import json
import os
import subprocess
import sys
from pathlib import Path

herdr = os.environ.get("HERDR_BIN_PATH", "herdr")
event = os.environ["HERDR_PLUGIN_EVENT"]
snapshot_path = Path(os.environ["HERDR_PLUGIN_STATE_DIR"]) / "pane-tabs.json"


def live_panes():
    out = subprocess.check_output([herdr, "pane", "list"], text=True)
    return json.loads(out)["result"]["panes"]


def save(panes):
    snapshot_path.write_text(json.dumps({p["pane_id"]: p["tab_id"] for p in panes}))


panes = live_panes()
previous = json.loads(snapshot_path.read_text()) if snapshot_path.exists() else {}
save(panes)

if event == "pane.created":
    tab = os.environ["HERDR_TAB_ID"]
elif event == "pane.closed":
    tab = previous.get(os.environ["HERDR_PANE_ID"])
else:
    sys.exit(0)  # startup: snapshot only
if tab is None:
    sys.exit(0)  # closed pane predates the snapshot; don't guess a tab

in_tab = [p for p in panes if p["tab_id"] == tab]
if not in_tab:
    sys.exit(0)  # whole tab closed
target = next((p for p in in_tab if p["focused"]), in_tab[0])["pane_id"]
os.environ["HERDR_ACTIVE_PANE_ID"] = target
os.execv(os.path.expanduser("~/.local/bin/herdr-balance-panes"), ["herdr-balance-panes"])
