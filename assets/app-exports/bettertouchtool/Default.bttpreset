              "BTTShellTaskActionScript" : "#!/bin/bash\n# Herdr: focus the previous tab in the current workspace (wraps around).\nexport PATH=\"/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:$PATH\"\ncommand -v herdr >/dev/null 2>&1 || exit 0\npython3 - <<'PYEOF2'\nimport json, subprocess\ndirection = \"prev\"\ntry:\n    out = subprocess.run([\"herdr\", \"tab\", \"list\"], capture_output=True, text=True, timeout=10).stdout\n    tabs = json.loads(out)[\"result\"][\"tabs\"]\nexcept Exception:\n    raise SystemExit(0)\nby_ws = {}\nfor t in tabs:\n    by_ws.setdefault(t[\"workspace_id\"], []).append(t)\ncur = next((t for t in tabs if t.get(\"focused\")), None)\nif cur is None:\n    raise SystemExit(0)\ngroup = sorted(by_ws[cur[\"workspace_id\"]], key=lambda t: t[\"number\"])\nids = [t[\"tab_id\"] for t in group]\ni = ids.index(cur[\"tab_id\"])\ntarget = ids[(i + 1) % len(ids)] if direction == \"next\" else ids[(i - 1) % len(ids)]\nif target != cur[\"tab_id\"]:\n    subprocess.run([\"herdr\", \"tab\", \"focus\", target])\nPYEOF2",
