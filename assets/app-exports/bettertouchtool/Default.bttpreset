        {
          "BTTLastUpdatedAt" : 1792787745.8216991,
          "BTTTriggerType" : 100,
          "BTTTriggerTypeDescription" : "3 Finger Swipe Left",
          "BTTTriggerTypeDescriptionReadOnly" : "3 Finger Swipe Left",
          "BTTTriggerClass" : "BTTTriggerTypeTouchpadAll",
          "BTTUUID" : "B6AFB938-8BD7-47E6-B8BA-955B55CF4F6D",
          "BTTOrder" : 2,
          "BTTActionsToExecute" : [
            {
              "BTTLastUpdatedAt" : 1792787745.8216991,
              "BTTTriggerParentUUID" : "B6AFB938-8BD7-47E6-B8BA-955B55CF4F6D",
              "BTTIsPureAction" : true,
              "BTTTriggerClass" : "BTTTriggerTypeTouchpadAll",
              "BTTUUID" : "A83E63C9-7FE2-462D-A85F-208CC0161580",
              "BTTPredefinedActionType" : 206,
              "BTTPredefinedActionName" : "Execute Shell Script / Task",
              "BTTShellTaskActionScript" : "#!/bin/bash\n# Herdr: focus the previous tab in the current workspace (wraps around).\nexport PATH=\"/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:$PATH\"\ncommand -v herdr >/dev/null 2>&1 || exit 0\npython3 - <<'PYEOF2'\nimport json, subprocess\ndirection = \"prev\"\ntry:\n    out = subprocess.run([\"herdr\", \"tab\", \"list\"], capture_output=True, text=True, timeout=10).stdout\n    tabs = json.loads(out)[\"result\"][\"tabs\"]\nexcept Exception:\n    raise SystemExit(0)\nby_ws = {}\nfor t in tabs:\n    by_ws.setdefault(t[\"workspace_id\"], []).append(t)\ncur = next((t for t in tabs if t.get(\"focused\")), None)\nif cur is None:\n    raise SystemExit(0)\ngroup = sorted(by_ws[cur[\"workspace_id\"]], key=lambda t: t[\"number\"])\nids = [t[\"tab_id\"] for t in group]\ni = ids.index(cur[\"tab_id\"])\ntarget = ids[(i + 1) % len(ids)] if direction == \"next\" else ids[(i - 1) % len(ids)]\nif target != cur[\"tab_id\"]:\n    subprocess.run([\"herdr\", \"tab\", \"focus\", target])\nPYEOF2",
              "BTTShellTaskActionConfig" : "/bin/bash:::-c:::-:::",
              "BTTOrder" : 2
            }
          ]
        },
        {
          "BTTLastUpdatedAt" : 1792787745.8216991,
          "BTTTriggerType" : 101,
          "BTTTriggerTypeDescription" : "3 Finger Swipe Right",
          "BTTTriggerTypeDescriptionReadOnly" : "3 Finger Swipe Right",
          "BTTTriggerClass" : "BTTTriggerTypeTouchpadAll",
          "BTTUUID" : "3F517266-2B45-4D49-AAB8-5E96322D90AE",
          "BTTOrder" : 3,
          "BTTActionsToExecute" : [
            {
              "BTTLastUpdatedAt" : 1792787745.8216991,
              "BTTTriggerParentUUID" : "3F517266-2B45-4D49-AAB8-5E96322D90AE",
              "BTTIsPureAction" : true,
              "BTTTriggerClass" : "BTTTriggerTypeTouchpadAll",
              "BTTUUID" : "59214AC4-0C8E-4B80-A16F-B413C2B3BC4F",
              "BTTPredefinedActionType" : 206,
              "BTTPredefinedActionName" : "Execute Shell Script / Task",
              "BTTShellTaskActionScript" : "#!/bin/bash\n# Herdr: focus the next tab in the current workspace (wraps around).\nexport PATH=\"/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:$PATH\"\ncommand -v herdr >/dev/null 2>&1 || exit 0\npython3 - <<'PYEOF2'\nimport json, subprocess\ndirection = \"next\"\ntry:\n    out = subprocess.run([\"herdr\", \"tab\", \"list\"], capture_output=True, text=True, timeout=10).stdout\n    tabs = json.loads(out)[\"result\"][\"tabs\"]\nexcept Exception:\n    raise SystemExit(0)\nby_ws = {}\nfor t in tabs:\n    by_ws.setdefault(t[\"workspace_id\"], []).append(t)\ncur = next((t for t in tabs if t.get(\"focused\")), None)\nif cur is None:\n    raise SystemExit(0)\ngroup = sorted(by_ws[cur[\"workspace_id\"]], key=lambda t: t[\"number\"])\nids = [t[\"tab_id\"] for t in group]\ni = ids.index(cur[\"tab_id\"])\ntarget = ids[(i + 1) % len(ids)] if direction == \"next\" else ids[(i - 1) % len(ids)]\nif target != cur[\"tab_id\"]:\n    subprocess.run([\"herdr\", \"tab\", \"focus\", target])\nPYEOF2",
              "BTTShellTaskActionConfig" : "/bin/bash:::-c:::-:::",
